{
  "name": "es-samples",
  "version": "1.0.0",
  "description": "ECMAScript code samples library (ES2011-ES2026)",
  "type": "module",
  "main": "./samples/index.js",
  "exports": {
    ".": "./samples/index.js",
    "./samples": "./samples/index.js",
    "./samples/index.js": "./samples/index.js",
    "./features.json": "./features.json",
    "./features": "./features.json",
    "./samples/*": "./samples/*",
    "./*": "./samples/*"
  },
  "scripts": {
    "build:features": "node scripts/build-features.js",
    "update:features": "node scripts/update-features.js",
    "update:deps": "npm i @mdn/browser-compat-data@latest web-features@latest && npm i -D typescript@latest",
    "refresh": "npm run update:deps && npm run update:features && npm test",
    "test": "node scripts/build-features.js && node samples/test.js"
  },
  "keywords": [
    "ecmascript",
    "javascript",
    "es5",
    "es2011",
    "es2015",
    "es2026"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mdn/browser-compat-data": "^8.1.4",
    "web-features": "^3.40.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
